# ---------------------------------------------------------------------------
# Minecraft server
# ---------------------------------------------------------------------------
MC_HOST=127.0.0.1
# Query protocol port (query.port in server.properties, needs enable-query=true)
QUERY_PORT=25565
# RCON (enable-rcon / rcon.port / rcon.password in server.properties)
RCON_PORT=25575
RCON_PASSWORD=change-me

# The minecraft-server folder (contains start.bat). Relative to this folder.
SERVER_DIR=../minecraft-server
# Optional: exact join/leave timestamps from the server log. Leave empty to
# detect joins/leaves by comparing player lists every poll instead.
MC_LOG_PATH=../minecraft-server/logs/latest.log

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
PORT=8080
# Bind address. 127.0.0.1 = this PC only. Use 0.0.0.0 to reach it from your LAN.
HOST=127.0.0.1
# Strongly recommended if HOST is not 127.0.0.1. Leave the password empty to disable login.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
POLL_INTERVAL_SECONDS=30
# How much history the charts keep
HISTORY_HOURS=24

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
TPS_ALERT_THRESHOLD=15
# Alert after this many polls in a row below the threshold (2 x 30s = 1 minute)
TPS_ALERT_CONSECUTIVE=2
# Declare the server offline after this many failed polls in a row
OFFLINE_CONSECUTIVE=2
# Minimum minutes between repeated alerts of the same kind
ALERT_COOLDOWN_MINUTES=15
# Optional: role to @mention on critical alerts (offline / crash), e.g. 123456789012345678
ALERT_ROLE_ID=

# ---------------------------------------------------------------------------
# Watchdog (npm run watchdog)
# ---------------------------------------------------------------------------
START_SCRIPT=start.bat
RESTART_DELAY_SECONDS=10
# Give up after this many crashes within RESTART_WINDOW_MINUTES (crash loop protection)
MAX_RESTARTS=5
RESTART_WINDOW_MINUTES=15
# Kill and restart if the server stops answering for this long (0 = disabled)
HANG_TIMEOUT_SECONDS=180
# Don't check for hangs until the server has had this long to start
STARTUP_GRACE_SECONDS=300
# Restart even when the server exits cleanly (e.g. someone ran /stop in game).
# Typing "stop" into the watchdog window always stops for real.
RESTART_ON_CLEAN_EXIT=true
