# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=your-bot-token-here
# Application ID (General Information page) - used to register slash commands
CLIENT_ID=123456789012345678
# Your Discord server (guild) ID - slash commands are registered here instantly
GUILD_ID=123456789012345678

# Channel that mirrors Minecraft chat (both directions)
BRIDGE_CHANNEL_ID=123456789012345678
# Private staff channel where /whitelist requests are posted
ADMIN_CHANNEL_ID=123456789012345678
# Optional: members with this role can approve/deny requests.
# Members with the "Manage Server" permission can always approve.
ADMIN_ROLE_ID=

# ---------------------------------------------------------------------------
# Minecraft
# ---------------------------------------------------------------------------
# Address players type into Minecraft (shown in /status)
SERVER_IP=play.example.com

# RCON (must match enable-rcon / rcon.port / rcon.password in server.properties)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change-me

# Path to the server's logs/latest.log - used to relay Minecraft chat to Discord.
# Relative paths are resolved from this folder.
MC_LOG_PATH=../minecraft-server/logs/latest.log

# How often (seconds) the bot refreshes the player count in its status
STATUS_INTERVAL=30
